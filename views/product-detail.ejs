<%- include("partials/head", { title: 'Detail Produk - Toko Sembako Ariesta' }) %>
<%- include("partials/navbar") %>

<main class="container flex-grow-1">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-body">
          <h2 class="card-title text-primary"><%= product.name %></h2>
          <h5 class="card-subtitle mb-3 text-muted">Kategori: <%= product.category %></h5>
          
          <hr>
          
          <div class="row mt-4">
            <div class="col-md-6">
              <p class="fs-5">Harga: <span class="fw-bold">Rp <%= product.price.toLocaleString('id-ID') %></span></p>
            </div>
            <div class="col-md-6">
              <p class="fs-5">Stok Tersedia: <span class="fw-bold"><%= product.stock %></span></p>
            </div>
          </div>
          
          <div class="mt-4">
            <a href="/produk" class="btn btn-secondary">&laquo; Kembali ke Produk</a>
            <a href="/tanya-ai" class="btn btn-primary">Tanya Ongkir &raquo;</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include("partials/footer") %>
</body>
</html>
